# QR Code / Join URL — set this to your Vercel production domain.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is auto-provided, but Vite
# only exposes VITE_ prefixed vars to client code. This bridges the gap.
# If you set VITE_PUBLIC_APP_URL it takes highest priority.
# Example: VITE_PUBLIC_APP_URL="https://kct-classroom-flow.vercel.app"
VITE_VERCEL_PROJECT_PRODUCTION_URL="${VERCEL_PROJECT_PRODUCTION_URL}"
VITE_VERCEL_URL="${VERCEL_URL}"

# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDERS — SERVER-ONLY CREDENTIALS
# Never use the VITE_ prefix for AI keys: Vite inlines VITE_* variables into the
# browser bundle. Set these only in the server environment (Vercel project
# settings or an untracked local file). Never commit real values.
# Each variable accepts one key or a comma-separated list for failover.
# ─────────────────────────────────────────────────────────────────────────────
GROQ_API_KEYS=
GEMINI_API_KEYS=
NVIDIA_API_KEYS=
TOGETHER_API_KEYS=
# Optional failover order, e.g. groq,gemini,nvidia,together
AI_PROVIDER_ORDER=
# Firebase project ID used by the server to verify Firebase ID tokens (not a secret).
# Falls back to VITE_FIREBASE_PROJECT_ID when unset.
FIREBASE_PROJECT_ID=
